# Copy this file to .env.local on each development computer, then add the
# values from your Supabase and OpenWeather dashboards. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Production browser origin used by Supabase confirmation and reset emails.
# Use the current Vercel production URL until a custom domain is live.
NEXT_PUBLIC_SITE_URL=https://frontline-forecast-the-weather-desk.vercel.app
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
OPENWEATHER_API_KEY=
# GribStream MRMS radar (https://gribstream.com) — optional. Live composite
# reflectivity silently falls back to the existing NOAA/IEM provider tiles
# when this is unset or a request fails, so it's safe to leave blank.
GRIBSTREAM_API_KEY=
# Instant kill switch — set to "true" to force GribStream off (falls back to
# the original provider tiles) without removing the key above. Check current
# usage first: curl -H "Authorization: Bearer $CRON_SECRET" <site>/api/radar/gribstream/status
GRIBSTREAM_DISABLED=
# Optional legacy cross-site configuration URL. Leave blank: the production
# site reads only published public settings from the shared Supabase control plane.
COMPANY_HQ_CONFIG_URL=
# CARTO basemap tiles — free, no account needed: request a key at
# https://carto.com/basemaps/apikey/ (email + this site's domain + a one-line description, key
# emailed instantly). Without this, basemap tiles render with an "API KEY REQUIRED" watermark.
NEXT_PUBLIC_CARTO_API_KEY=
# Sentry error tracking (optional — usage/bug-fixing only, deliberately configured with no student
# data access, see src/instrumentation.ts). Free account at https://sentry.io, create a Next.js
# project, copy its DSN here. Leave blank to disable error tracking entirely.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed for readable production stack traces (source map upload at build time) — optional,
# error tracking works without these. From the same Sentry project's settings.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
