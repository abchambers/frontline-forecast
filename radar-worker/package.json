{
  "name": "frontline-forecast-radar-worker",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "In-house NEXRAD Level II/III ingestion worker. A persistent process (Fly.io), not a serverless route — see docs in this directory.",
  "scripts": {
    "test:kffc": "tsx scripts/test-kffc.ts",
    "render:preview": "tsx scripts/render-preview.ts",
    "mosaic:prototype": "tsx scripts/mosaic-prototype.ts",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "nexrad-level-2-data": "^2.4.3",
    "nexrad-level-3-data": "^0.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
