{
  "crons": [
    {
      "path": "/api/cron/verify",
      "schedule": "15 12 * * *"
    },
    {
      "path": "/api/cron/observations",
      "schedule": "25 12 * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "35 12 * * *"
    },
    {
      "path": "/api/cron/outlook",
      "schedule": "45 12 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.frontline-forecast.com"
        }
      ],
      "destination": "https://frontline-forecast.com/$1",
      "permanent": true
    }
  ]
}
